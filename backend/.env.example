# SMTP (mailbox.org or similar)
SMTP_HOST=smtp.mailbox.org
SMTP_PORT=465
SMTP_USER=your-user@european-resolve.org
SMTP_PASS=your-app-password-here
SMTP_FROM="Run for Ukraine 2026 <noreply@european-resolve.org>"
SMTP_REPLY_TO=info@european-resolve.org

# Optional: path to registrations TSV export (default: /tmp/registrations.tsv)
# DEPLOYMENT_RECIPIENTS_TSV=/tmp/registrations.tsv

# IMAP (mailbox.org app password with mail scope)
IMAP_HOST=imap.mailbox.org
IMAP_PORT=993
IMAP_USER=your-user@european-resolve.org
IMAP_PASS=your-imap-app-password-here

# DMARC report ingest (process-dmarc-reports)
# DMARC_MAILBOX_FOLDER=INBOX
# DMARC_ARCHIVE_FOLDER=DMARC-Reports
# DMARC_SINCE_DAYS=90
# DMARC_DRY_RUN=true
